<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top Red Banner with Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="#FF0000"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:src="@drawable/white_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:contentDescription="Logo" /


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nourify"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Welcome Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to LifePath"
            android:textSize="24sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <!-- AR Feature Image (Clickable) -->
        <ImageView
            android:id="@+id/iv_ar_feature"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/ar_icon"
            android:scaleType="fitCenter"
            android:contentDescription="AR Feature Image"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <!-- AR View Launch Button -->
        <Button
            android:id="@+id/btn_launch_ar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Launch Augmented Reality"
            android:textSize="18sp"
            android:backgroundTint="#FF0000"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp" />

        <!-- Illustrative Image Placeholder -->
        <ImageView
            android:id="@+id/home_illustration"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/home_illustration"
            android:scaleType="fitCenter"
            android:layout_marginBottom="32dp"
            android:contentDescription="LifePath Illustration" />

        <!-- Button to Navigate to KPI Dashboard -->
        <Button
            android:id="@+id/btn_kpi_dashboard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="View Performance Dashboard"
            android:textSize="18sp"
            android:backgroundTint="#FF0000"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
