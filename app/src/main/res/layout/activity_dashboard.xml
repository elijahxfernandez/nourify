<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="#FF0000"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:src="@drawable/white_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:contentDescription="Logo" /


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nourify"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>
        <TextView
            android:text='Key Performance Indictaors'
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FF0000"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Behavioral Performance"
            android:textSize="14sp"
            android:textColor="#666"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Progress Score Card -->
        <LinearLayout
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Progress Score"
                    android:textColor="#5E35B1"
                    android:textSize="16sp" />

                <TextView
                    android:text="92.7%"
                    android:textColor="#000000"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/progress_icon" />
        </LinearLayout>

        <!-- Productivity & Action Meter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:layout_marginEnd="8dp"
                android:elevation="2dp">

                <TextView android:text="Productivity" android:textColor="#000000" />
                <TextView android:text="87%" android:textColor="#FF7043" android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp">

                <TextView android:text="Action Meter" android:textColor="#000000" />
                <TextView android:text="94%" android:textColor="#26C6DA" android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mood Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView android:text="Mood Metrics" android:textStyle="bold" android:textColor="#000000" android:layout_marginBottom="8dp" />

            <LinearLayout android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="space_evenly">

                <!-- Positive -->
                <LinearLayout android:orientation="vertical" android:gravity="center">
                    <ImageView android:src="@drawable/smile_green" android:layout_width="32dp" android:layout_height="32dp"/>
                    <TextView android:text="65%" android:textColor="#66BB6A"/>
                    <TextView android:text="Positive" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Neutral -->
                <LinearLayout android:orientation="vertical" android:gravity="center">
                    <ImageView android:src="@drawable/neutral_yellow" android:layout_width="32dp" android:layout_height="32dp"/>
                    <TextView android:text="25%" android:textColor="#FFCA28"/>
                    <TextView android:text="Neutral" android:textSize="12sp"/>
                </LinearLayout>

                <!-- Negative -->
                <LinearLayout android:orientation="vertical" android:gravity="center">
                    <ImageView android:src="@drawable/sad_red" android:layout_width="32dp" android:layout_height="32dp"/>
                    <TextView android:text="10%" android:textColor="#EF5350"/>
                    <TextView android:text="Negative" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Efficiency Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="space_between|center_vertical">

            <TextView android:text="Efficiency Score" android:textColor="#000000" android:textStyle="bold" />

            <TextView android:text="High Performance"
                android:background="#E0F2F1"
                android:padding="6dp"
                android:textColor="#388E3C"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
